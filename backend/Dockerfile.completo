# Multi-stage build para imagen completa con PostgreSQL + Backend
# Para pruebas académicas: incluye todo en una sola imagen

# Stage 1: Build del backend
FROM node:22-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npx prisma generate
RUN npm run build

# Stage 2: Imagen final con PostgreSQL + Backend
FROM node:22-alpine

# Instalar PostgreSQL desde repositorios de Alpine
RUN apk add --no-cache postgresql postgresql-client bash shadow

# Crear usuario y grupo postgres
RUN addgroup -g 70 postgres && \
    adduser -D -u 70 -G postgres postgres

# Crear directorio para datos de PostgreSQL
RUN mkdir -p /var/lib/postgresql/data && \
    chown -R postgres:postgres /var/lib/postgresql

# Copiar archivos del backend desde builder
WORKDIR /app
COPY --from=builder /app/package*.json ./
RUN npm ci --only=production && npm cache clean --force

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/prisma ./prisma

# Instalar Prisma CLI para migraciones
RUN npm install -g prisma@^6.18.0

# Crear script de inicio usando printf para evitar problemas con heredoc
RUN printf '#!/bin/sh\n\
set -e\n\
\n\
echo "🚀 Starting PostgreSQL..."\n\
\n\
# Inicializar PostgreSQL si no está inicializado\n\
if [ ! -f /var/lib/postgresql/data/PG_VERSION ]; then\n\
    echo "📦 Initializing PostgreSQL database..."\n\
    su postgres -c "initdb -D /var/lib/postgresql/data"\n\
    echo "host all all 0.0.0.0/0 md5" >> /var/lib/postgresql/data/pg_hba.conf\n\
    echo "listen_addresses = '"'"'*'"'"'" >> /var/lib/postgresql/data/postgresql.conf\n\
fi\n\
\n\
# Iniciar PostgreSQL en background\n\
su postgres -c "/usr/bin/postgres -D /var/lib/postgresql/data" &\n\
POSTGRES_PID=$!\n\
\n\
echo "⏳ Waiting for PostgreSQL to be ready..."\n\
sleep 5\n\
\n\
# Esperar a que PostgreSQL esté listo\n\
until pg_isready -h localhost -U postgres; do\n\
  sleep 1\n\
done\n\
\n\
echo "✅ PostgreSQL is ready!"\n\
\n\
# Crear base de datos si no existe\n\
psql -U postgres -c "SELECT 1 FROM pg_database WHERE datname='"'"'ds_db'"'"'" | grep -q 1 || \\\n\
psql -U postgres -c "CREATE DATABASE ds_db;"\n\
\n\
echo "📦 Running migrations..."\n\
cd /app\n\
export DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ds_db?schema=public"\n\
npx prisma migrate deploy || echo "Migrations failed or already applied"\n\
\n\
echo "🚀 Starting backend..."\n\
export DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ds_db?schema=public"\n\
export PORT=8081\n\
export HOST=0.0.0.0\n\
exec node dist/src/main.js\n' > /start.sh && chmod +x /start.sh

# Variables de entorno
ENV NODE_ENV=production
ENV PORT=8081
ENV DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ds_db?schema=public
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV POSTGRES_DB=ds_db
ENV PGDATA=/var/lib/postgresql/data

# Exponer puertos
EXPOSE 8081 5432

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8081/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1

# Comando de inicio
CMD ["/start.sh"]
