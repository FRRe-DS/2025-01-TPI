// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de autenticación para el portal de compras ShopFlow
model Auth {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String? // Primer nombre
  lastName  String? // Apellido
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con tokens
  tokens Token[]

  // Relación con perfil de usuario
  profile UserProfile?
}

// Modelo de tokens para autenticación
model Token {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relación con usuario
  user Auth @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Modelo de perfil de usuario complementario
model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  phone     String
  dni       String
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con usuario
  user Auth @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Modelo de carrito de compras
// userId es el UUID de Keycloak (string), no el ID de Auth
model CartItem {
  id        Int      @id @default(autoincrement())
  userId    String // UUID de Keycloak
  productId Int // ID del producto del backend de stock
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Índice único para evitar duplicados (un usuario no puede tener el mismo producto dos veces)
  @@unique([userId, productId])
  @@index([userId])
}

// Modelo de órdenes de compra
// userId es el UUID de Keycloak (string)
model Order {
  id            Int      @id @default(autoincrement())
  userId        String   // UUID de Keycloak
  orderId       BigInt   @unique // ID único de la orden (timestamp en milisegundos)
  shippingId    Int?     // ID del envío del backend de logística
  status        String   @default("pending") // pending, confirmed, shipped, delivered, cancelled
  transportType String?  // Tipo de transporte: air, sea, road, rail
  shippingCost  Decimal? @db.Decimal(10, 2) // Costo de envío
  deliveryAddress Json   // Dirección de entrega: { street, city, state, postal_code, country }
  products      Json     // Productos: [{ id, quantity, price }]
  totalAmount   Decimal  @db.Decimal(10, 2) // Total de la orden (productos + envío)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([createdAt])
}
