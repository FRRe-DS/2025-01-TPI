# Keycloak Configuration
# Usar KEYCLOAK_ISSUER como única variable (compatible con STOCK)
KEYCLOAK_ISSUER=http://localhost:8080/realms/ds-2025-realm

# Keycloak Admin Configuration (para operaciones administrativas)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ds2025

# Database Configuration
# Para desarrollo local con Docker, usar el puerto 5434 (compras_postgres)
# Para desarrollo local sin Docker, usar el puerto 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/ds_db?schema=public

# Server Configuration
PORT=8081
NODE_ENV=development

# Legacy Keycloak Configuration (obsoleto, usar KEYCLOAK_ISSUER en su lugar)
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=ds-2025-realm

